//SYNTAX
//CODE PROPER
//--- Getting input using Scanner-----
import java.util.Scanner;// Syntax for calling the // Input function on the variable in the module Scanner
public class Main {
    public static void main(String[] args){
        Scanner scanner = new Scanner(System.in);//Reading the one word(stop at whitespace)

// Declaring variables of different data types---
int age = 19;
double price = 20.30;
float weight = 70.6f;
char grade = 'A';
boolean isStudent = true;
String name = "Jerald";

//---Output using System.out.println-----
System.out.println("Name: " +name);//Jerald
System.out.println("Age: " +age);//19
System.out.println("Price: " +price);//20.30
System.out.println("Weight: " +weight);//70.60
System.out.println("Grade: " +grade);//A
System.out.println("Is Student? " +isStudent);//True);

        System.out.print("\nEnter your city: ");
        String userCity =scanner.next(); //reads one word
        System.out.println("You live in: "+userCity);

        //Reading the full line (including spaces)
        scanner.nextLine();// clears leftover newline from previous next()
        System.out.print("Enter a sentence about yourself: ");
        String fullsentence = scanner.nextLine();// reads the entire line or paragraph.
        System.out.println("You said: "+fullsentence);

//Operators and Expressions
//=,-,*,/,%,&&,||,>,<,<=,>=,!=
int a =10, b =3;
System.out.println("a + b ="+(a+b));
System.out.println("a - b ="+(a-b));
System.out.println("a * b ="+(a*b));
System.out.println("a / b ="+(a/b));
System.out.println("a % b ="+(a%b));

double x =10, y =3;
System.out.println("x / y ="+(x/y));

//Relational operators (return bool: 1 or 0)
        System.out.println("\na == b = "+(a==b));
        System.out.println("\na != b = "+(a!=b));
        System.out.println("\na > b = "+(a>b));
        System.out.println("\na < b = "+(a<b));
        System.out.println("\na >= b = "+(a>=b));
        System.out.println("\na <= b = "+(a<=b));

//Logical operators
boolean p = true, q = false;
        System.out.println("\np && q: "+(p&&q));//AND
        System.out.println("\np || q: "+(p||q));//OR
        System.out.println("!p: "+(!p));//NOT TRUE
        System.out.println("!q: "+(!q));//NOT FALSE

//Assignment operators
// +=,-=,*=,/=
int score = 50;
score += 10;
System.out.println("\nscore after += 10: "+score);
score *= 2;
System.out.println("\nscore after *= 2: "+score);

//Increment / Decrement operators
int counter = 5;
System.out.println("\ncounter++ (post): "+counter++);//5
System.out.println("counter now: "+counter++);//6
System.out.println("++counter (pre): "+ counter++);//7

//Control Flow(if/else,switch case,loops(for,while,do while))
System.out.println("Enter your exam score: ");
int Examscore = scanner.nextInt();

if (Examscore >=90){
    System.out.println("Grade: A");
}
else if (Examscore >=80){
    System.out.println("Grade: B");
}
else if (Examscore >=70){
    System.out.println("Grade: C");
}
else{
    System.out.println("Grade: F");
}
        scanner.close();

    }
}


